# ══════════════════════════════════════════════════════════════
# AI 日记系统 —— 环境变量模板
# ══════════════════════════════════════════════════════════════
# 用法：
#   1. 复制本文件为 .env
#          Copy-Item .env.example .env
#   2. 至少填写 DB_PASSWORD 和 DIARY_ENCRYPTION_KEY
#   3. .env 已在 .gitignore 中，不会被提交
#
# ⚠️ 不要把真实值写进本文件（.env.example 是要提交 Git 的）
# ══════════════════════════════════════════════════════════════


# ──────────────────────────────────────────────────────────────
# 数据库（docker compose 中的 mysql 服务）
# ──────────────────────────────────────────────────────────────
DB_HOST=localhost
# ⚠️ 默认 3307 而非 3306：多数同学本机已装 MySQL 服务占用 3306，
#    映射到 3307 可避免端口冲突，也让本机原有的 MySQL 不受影响。
#    详见 docker-compose.yml 里 mysql.ports 的注释。
DB_PORT=3307
DB_NAME=ai_diary
DB_USERNAME=ai_diary
DB_PASSWORD=change-me
# MySQL root 密码，仅 docker compose 初始化时使用
DB_ROOT_PASSWORD=change-me-root


# ──────────────────────────────────────────────────────────────
# 后端服务
# ──────────────────────────────────────────────────────────────
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev


# ──────────────────────────────────────────────────────────────
# 认证（HttpOnly Cookie 会话）
# ──────────────────────────────────────────────────────────────
AUTH_COOKIE_NAME=AI_DIARY_SESSION
# 生产环境走 HTTPS 时必须改为 true，否则浏览器不会发送 Cookie
AUTH_COOKIE_SECURE=false
AUTH_SESSION_TIMEOUT=7d


# ──────────────────────────────────────────────────────────────
# 日记正文加密密钥（AES-256-GCM，必须是 Base64 编码的 32 字节）
# ──────────────────────────────────────────────────────────────
# 生成方法（任选一种）：
#
#   PowerShell:
#     [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
#
#   Linux / macOS / Git Bash:
#     openssl rand -base64 32
#
# ⚠️ 密钥丢失 = 所有日记正文永久无法解密，请务必备份
# ⚠️ 生产环境必须与本地使用不同的密钥
# ──────────────────────────────────────────────────────────────
DIARY_ENCRYPTION_KEY=replace-with-base64-encoded-32-bytes


# ──────────────────────────────────────────────────────────────
# AI —— Chat 模型（DeepSeek，OpenAI 兼容接口）
# ──────────────────────────────────────────────────────────────
# 默认关闭：没有 Key 的人 clone 下来也能正常启动、正常写日记，
# 只是不触发 AI 分析（前端显示"AI 未启用"）。
AI_ANALYSIS_ENABLED=false

AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=
AI_CHAT_MODEL=deepseek-chat

# 可靠性参数（对应 AI Agent 文档 §8.2）
AI_CONNECT_TIMEOUT_MS=5000
AI_READ_TIMEOUT_MS=30000
AI_MAX_RETRIES=3
AI_CONTEXT_TOKEN_BUDGET=6000


# ──────────────────────────────────────────────────────────────
# AI —— Embedding 模型（独立配置）
# ──────────────────────────────────────────────────────────────
# ⚠️ DeepSeek 不提供 Embedding API，需要单独一个提供商。
#    推荐（国内直连、有免费额度）：
#      阿里云百炼  https://dashscope.aliyuncs.com/compatible-mode/v1
#                  模型 text-embedding-v3 ，维度 1024
#      硅基流动    https://api.siliconflow.cn/v1
#                  模型 BAAI/bge-m3 ，维度 1024
#
#    Phase 5（语义检索）之前不需要填，Phase 0-4 用不到。
# ──────────────────────────────────────────────────────────────
AI_EMBEDDING_BASE_URL=
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_MODEL=
AI_EMBEDDING_DIMENSION=


# ──────────────────────────────────────────────────────────────
# 向量库（docker compose 中的 chroma 服务）
# ──────────────────────────────────────────────────────────────
VECTOR_STORE=chroma
VECTOR_DB_URL=http://localhost:8000


# ──────────────────────────────────────────────────────────────
# 前端
# ──────────────────────────────────────────────────────────────
# 走 Vite 代理，因此用相对路径即可（避免跨域导致 Cookie 失效）
VITE_API_BASE_URL=/api
VITE_DEV_PORT=5173
