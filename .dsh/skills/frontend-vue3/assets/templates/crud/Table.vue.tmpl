<template>
  <div class="{{entity}}-table">
    <table class="table">
      <thead>
        <tr>
          <th>ID</th>
          {{headers}}
          <th>Created At</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <tr v-if="items.length === 0">
          <td :colspan="7" class="text-center">No {{entity}}s found</td>
        </tr>
        <tr v-for="item in items" :key="item.id">
          <td>{{ item.id }}</td>
          {{rows}}
          <td>{{ formatDate(item.createdAt) }}</td>
          <td>
            <button @click="emit('edit', item.id)" class="btn-sm btn-primary">Edit</button>
            <button @click="emit('delete', item.id)" class="btn-sm btn-danger">Delete</button>
          </td>
        </tr>
      </tbody>
    </table>
  </div>
</template>

<script setup lang="ts">
import type { {{Entity}} } from '@/types/{{entity}}';

interface Props {
  items: {{Entity}}[];
  loading?: boolean;
}

interface Emits {
  (e: 'edit', id: number): void;
  (e: 'delete', id: number): void;
}

defineProps<Props>();
defineEmits<Emits>();

const formatDate = (date: string): string => {
  return new Date(date).toLocaleDateString();
};
</script>

