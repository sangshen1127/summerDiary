<template>
  <form @submit.prevent="handleSubmit" class="{{entity}}-form">
    {{form_fields}}

    <div class="form-actions">
      <button type="submit" :disabled="loading" class="btn btn-primary">
        {{ isEdit ? 'Update' : 'Create' }} {{Entity}}
      </button>
      <button type="button" @click="emit('cancel')" class="btn btn-secondary">
        Cancel
      </button>
    </div>

    <div v-if="error" class="error-message">{{ error }}</div>
  </form>
</template>

<script setup lang="ts">
import { ref, watch } from 'vue';
import type { {{Entity}}, Create{{Entity}}Request, Update{{Entity}}Request } from '@/types/{{entity}}';

interface Props {
  item?: {{Entity}} | null;
  loading?: boolean;
  error?: string | null;
}

interface Emits {
  (e: 'submit', payload: Create{{Entity}}Request | Update{{Entity}}Request): void;
  (e: 'cancel'): void;
}

const props = withDefaults(defineProps<Props>(), {
  loading: false,
});

const emit = defineEmits<Emits>();

// Form state
const formData = ref<Create{{Entity}}Request>({
  // Initialize fields here
});

const isEdit = ref(false);

// Watch for item changes to populate form
watch(
  () => props.item,
  (newItem) => {
    if (newItem) {
      isEdit.value = true;
      // Populate form with item data
      Object.keys(newItem).forEach((key) => {
        if (key !== 'id' && key !== 'createdAt' && key !== 'updatedAt') {
          (formData.value as any)[key] = (newItem as any)[key];
        }
      });
    } else {
      isEdit.value = false;
      resetForm();
    }
  }
);

const resetForm = () => {
  // Reset form to initial state
  Object.keys(formData.value).forEach((key) => {
    (formData.value as any)[key] = '';
  });
};

const handleSubmit = () => {
  emit('submit', formData.value);
};
</script>

