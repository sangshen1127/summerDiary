<template>
  <div class="{{entity}}-view">
    <div class="view-header">
      <h1>{{Entity}} Management</h1>
      <button @click="showForm = true" class="btn btn-primary">
        New {{Entity}}
      </button>
    </div>

    <!-- Loading State -->
    <div v-if="store.loading" class="loading">Loading...</div>

    <!-- Error State -->
    <div v-if="store.error" class="error">
      {{ store.error }}
      <button @click="store.clearError()" class="btn-close">×</button>
    </div>

    <!-- Form Modal -->
    <div v-if="showForm" class="modal-overlay" @click="closeForm">
      <div class="modal-content" @click.stop>
        <div class="modal-header">
          <h2>{{ store.currentItem ? 'Edit' : 'Create' }} {{Entity}}</h2>
          <button @click="closeForm" class="btn-close">×</button>
        </div>
        <{{Entity}}Form
          :item="store.currentItem"
          :loading="store.loading"
          :error="store.error"
          @submit="handleFormSubmit"
          @cancel="closeForm"
        />
      </div>
    </div>

    <!-- List -->
    <{{Entity}}Table
      :items="store.items"
      :loading="store.loading"
      @edit="handleEdit"
      @delete="handleDelete"
    />

    <!-- Pagination -->
    <div v-if="store.totalPages > 1" class="pagination">
      <button
        v-for="page in store.totalPages"
        :key="page"
        @click="goToPage(page)"
        :class="{ active: store.offset / store.limit + 1 === page }"
        class="pagination-btn"
      >
        {{ page }}
      </button>
    </div>
  </div>
</template>

<script setup lang="ts">
import { ref, onMounted } from 'vue';
import { use{{Entity}}Store } from '@/stores/{{entity}}.store';
import type { Create{{Entity}}Request, Update{{Entity}}Request } from '@/types/{{entity}}';
import {{Entity}}Table from './components/{{Entity}}Table.vue';
import {{Entity}}Form from './components/{{Entity}}Form.vue';

const store = use{{Entity}}Store();
const showForm = ref(false);

onMounted(() => {
  store.fetchList();
});

const closeForm = () => {
  showForm.value = false;
  store.clearCurrent();
};

const handleEdit = async (id: number) => {
  await store.fetchById(id);
  showForm.value = true;
};

const handleDelete = async (id: number) => {
  if (confirm('Are you sure you want to delete this {{entity}}?')) {
    try {
      await store.remove(id);
    } catch (error) {
      console.error('Failed to delete {{entity}}:', error);
    }
  }
};

const handleFormSubmit = async (payload: Create{{Entity}}Request | Update{{Entity}}Request) => {
  try {
    if (store.currentItem?.id) {
      await store.update(store.currentItem.id, payload as Update{{Entity}}Request);
    } else {
      await store.create(payload as Create{{Entity}}Request);
    }
    closeForm();
  } catch (error) {
    console.error('Failed to save {{entity}}:', error);
  }
};

const goToPage = (page: number) => {
  const newOffset = (page - 1) * store.limit;
  store.fetchList(newOffset, store.limit);
};
</script>

